@model OrderManagementApp.ViewModels.ForgotPasswordViewModel
@{ 
    ViewData["Title"] = "Forgot Password"; 
}

<div class="w-full max-w-md bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xl p-8 space-y-6">
    <div class="text-center space-y-1">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Reset Password</h1>
        <p class="text-xs text-slate-500">Enter your account email to receive a 6-digit verification code.</p>
    </div>

    <form asp-action="ForgotPassword" method="post" autocomplete="off" class="space-y-4 text-xs">
        <div asp-validation-summary="ModelOnly" class="text-rose-500 font-semibold"></div>

        <div>
            <label asp-for="Email" class="block font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Email Address</label>
            <input asp-for="Email" placeholder="Input Registered Email" autocomplete="off" spellcheck="false"
                   class="w-full h-10 px-3.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500" />
            <span asp-validation-for="Email" class="text-rose-500 mt-1 block"></span>
        </div>

        <button type="submit" class="w-full h-11 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-xl transition shadow-md">
            Send Verification Code
        </button>
    </form>

    <div class="pt-4 border-t border-slate-100 dark:border-slate-800 text-center text-xs text-slate-500">
        Remembered your password?
        <a asp-action="Login" class="font-semibold text-primary-600 dark:text-primary-400 hover:underline ml-1">
            Back to Login
        </a>
    </div>
</div>