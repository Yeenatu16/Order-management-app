@model OrderManagementApp.ViewModels.ResetPasswordViewModel
@{ 
    ViewData["Title"] = "Enter Verification Code"; 
}

<div class="w-full max-w-md bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xl p-8 space-y-6">
    <div class="text-center space-y-1">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Verify & Reset</h1>
        <p class="text-xs text-slate-500">Enter the 6-digit code sent to <strong class="text-primary-600">@(Model?.Email ?? "your email")</strong></p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-3 bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-200 text-emerald-700 dark:text-emerald-300 rounded-xl text-xs">
            @TempData["SuccessMessage"]
        </div>
    }

    <form asp-action="ResetPassword" method="post" autocomplete="off" class="space-y-4 text-xs">
        <div asp-validation-summary="ModelOnly" class="text-rose-500 font-semibold"></div>
        <input type="hidden" asp-for="Email" />

        <div>
            <label asp-for="VerificationCode" class="block font-semibold text-slate-700 dark:text-slate-300 mb-1.5">6-Digit Verification Code</label>
            <input asp-for="VerificationCode" placeholder="123456" maxlength="6" autocomplete="off"
                   class="w-full h-11 px-3.5 text-center tracking-[8px] font-mono text-lg rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500" />
            <span asp-validation-for="VerificationCode" class="text-rose-500 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="NewPassword" class="block font-semibold text-slate-700 dark:text-slate-300 mb-1.5">New Password</label>
            <input asp-for="NewPassword" placeholder="Input New Password" autocomplete="new-password"
                   class="w-full h-10 px-3.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500" />
            <span asp-validation-for="NewPassword" class="text-rose-500 mt-1 block"></span>
        </div>

        <button type="submit" class="w-full h-11 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-xl transition shadow-md">
            Reset Password
        </button>
    </form>
</div>