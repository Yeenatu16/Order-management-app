@model ResetPasswordViewModel
@{ ViewData["Title"] = "Reset Password Verification"; }

<div class="w-full max-w-md bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xl p-8 space-y-6">
    <div class="text-left">
        <h1 class="text-lg font-bold text-slate-900 dark:text-white">Set New Password</h1>
        <p class="text-xs text-slate-500 mt-0.5">Enter the verification code and your new credentials.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-3 bg-indigo-50 dark:bg-indigo-950/50 rounded-xl border border-indigo-200 text-xs text-indigo-700 dark:text-indigo-300">
            @TempData["SuccessMessage"]
        </div>
    }

    <form asp-action="ResetPassword" method="post" class="space-y-4 text-xs">
        <div asp-validation-summary="ModelOnly" class="text-rose-500 font-semibold"></div>

        <input type="hidden" asp-for="Email" />

        <div>
            <label asp-for="VerificationCode" class="block font-semibold text-slate-700 dark:text-slate-300 mb-1.5">6-Digit Verification Code</label>
            <input asp-for="VerificationCode" maxlength="6" placeholder="123456"
                   class="w-full h-10 px-3.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white font-mono tracking-widest text-center focus:outline-none focus:ring-2 focus:ring-primary-500" />
            <span asp-validation-for="VerificationCode" class="text-rose-500 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="NewPassword" class="block font-semibold text-slate-700 dark:text-slate-300 mb-1.5">New Password</label>
            <input asp-for="NewPassword" placeholder="Input Password"
                   class="w-full h-10 px-3.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500" />
            <span asp-validation-for="NewPassword" class="text-rose-500 mt-1 block"></span>
        </div>

        <button type="submit" class="w-full h-10 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold rounded-xl transition shadow-md">
            Reset Password & Login
        </button>
    </form>

    <div class="pt-3 border-t border-slate-100 dark:border-slate-800 text-center">
        <a asp-action="Login" class="text-xs font-semibold text-slate-500 hover:text-slate-700 dark:hover:text-slate-300">
            ← Back to Log In
        </a>
    </div>
</div>