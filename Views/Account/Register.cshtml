@model RegisterViewModel
@{ ViewData["Title"] = "Register"; }

<div class="w-full max-w-md bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xl p-8 space-y-6">
    <div class="text-center space-y-1">
        <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Create Account</h1>
        <p class="text-xs text-slate-500">Order Management Portal Access</p>
    </div>

    <form asp-action="Register" method="post" autocomplete="off" class="space-y-4 text-xs">
        <div asp-validation-summary="ModelOnly" class="text-rose-500 font-semibold"></div>

        <div>
            <label asp-for="FullName" class="block font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Full Name</label>
            <input asp-for="FullName" placeholder="Input Full Name" autocomplete="off" spellcheck="false"
                   class="w-full h-10 px-3.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500" />
            <span asp-validation-for="FullName" class="text-rose-500 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Email" class="block font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Email Address</label>
            <input asp-for="Email" placeholder="Input Email" autocomplete="off" spellcheck="false"
                   class="w-full h-10 px-3.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500" />
            <span asp-validation-for="Email" class="text-rose-500 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Password" class="block font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Password</label>
            <input asp-for="Password" placeholder="Input Password" autocomplete="new-password"
                   class="w-full h-10 px-3.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500" />
            <span asp-validation-for="Password" class="text-rose-500 mt-1 block"></span>
        </div>

        <div>
            <label asp-for="Role" class="block font-semibold text-slate-700 dark:text-slate-300 mb-1.5">Account Role Type</label>
            <select asp-for="Role" id="roleSelect" onchange="toggleAdminBox()" autocomplete="off"
                    class="w-full h-10 px-3.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-primary-500">
                <option value="User">Standard User</option>
                <option value="Admin">Administrator</option>
            </select>
        </div>

        <div id="adminCodeContainer" class="@(Model?.Role == "Admin" ? "" : "hidden") p-3 rounded-xl bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-900 space-y-1.5">
            <label asp-for="AdminSecretCode" class="block text-xs font-bold text-amber-800 dark:text-amber-300">
                Admin Authorization Code <span class="text-rose-500">*</span>
            </label>
            <input asp-for="AdminSecretCode" placeholder="Input Admin Authorization Code" autocomplete="off"
                   class="w-full h-9 px-3 rounded-lg border border-amber-300 dark:border-amber-800 bg-white dark:bg-slate-900 text-slate-900 dark:text-white font-mono focus:outline-none focus:ring-2 focus:ring-amber-500" />
            <span asp-validation-for="AdminSecretCode" class="text-rose-500 block"></span>
            <p class="text-[10px] text-amber-600 dark:text-amber-400">Security code required to provision administrator privileges.</p>
        </div>

        <button type="submit" class="w-full h-11 bg-primary-600 hover:bg-primary-700 text-white font-semibold rounded-xl transition shadow-md">
            Create Account
        </button>
    </form>

    <div class="pt-4 border-t border-slate-100 dark:border-slate-800 text-center text-xs text-slate-500">
        Already have an account?
        <a asp-action="Login" class="font-semibold text-primary-600 dark:text-primary-400 hover:underline ml-1">
            Log In
        </a>
    </div>
</div>

<script>
    function toggleAdminBox() {
        const isAdmin = document.getElementById('roleSelect').value === 'Admin';
        document.getElementById('adminCodeContainer').classList.toggle('hidden', !isAdmin);
    }
</script>