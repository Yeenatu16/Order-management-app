@model DashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="max-w-7xl mx-auto space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">System Dashboard</h1>
            <p class="text-xs text-slate-500 dark:text-slate-400">Global sales metrics, active catalog counters, and order velocity.</p>
        </div>
        <span class="px-3 py-1 text-xs font-medium rounded-full bg-indigo-50 text-indigo-700 dark:bg-indigo-950 dark:text-indigo-300 border border-indigo-200 dark:border-indigo-800 w-fit">
            Live System Analytics
        </span>
    </div>

    <!-- KPI Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <div class="p-5 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-2">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total System Revenue</p>
            <div class="flex items-baseline justify-between">
                <h3 class="text-2xl font-bold font-mono text-slate-900 dark:text-white">ETB @Model.TotalRevenue.ToString("N2")</h3>
                <span class="text-xs font-semibold text-emerald-600 bg-emerald-50 dark:bg-emerald-950 px-2 py-0.5 rounded-full">+14.2%</span>
            </div>
        </div>

        <div class="p-5 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-2">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Total Orders Placed</p>
            <div class="flex items-baseline justify-between">
                <h3 class="text-2xl font-bold font-mono text-slate-900 dark:text-white">@Model.TotalOrders</h3>
                <span class="text-xs font-semibold text-indigo-600 bg-indigo-50 dark:bg-indigo-950 px-2 py-0.5 rounded-full">All Users</span>
            </div>
        </div>

        <div class="p-5 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-2">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Catalog Products</p>
            <div class="flex items-baseline justify-between">
                <h3 class="text-2xl font-bold font-mono text-slate-900 dark:text-white">@Model.TotalProducts</h3>
                <span class="text-xs font-semibold text-purple-600 bg-purple-50 dark:bg-purple-950 px-2 py-0.5 rounded-full">Active SKU</span>
            </div>
        </div>

        <div class="p-5 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-2">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Avg. Order Value</p>
            <div class="flex items-baseline justify-between">
                <h3 class="text-2xl font-bold font-mono text-slate-900 dark:text-white">ETB @Model.AverageOrderValue.ToString("N2")</h3>
                <span class="text-xs font-semibold text-amber-600 bg-amber-50 dark:bg-amber-950 px-2 py-0.5 rounded-full">Per Cart</span>
            </div>
        </div>
    </div>

    <!-- Recent Order Activity Table -->
    <div class="p-6 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
            <h2 class="text-sm font-bold text-slate-900 dark:text-white">Recent Order Activity</h2>
            <a asp-controller="Orders" asp-action="Index" class="text-xs font-semibold text-primary-600 dark:text-primary-400 hover:underline">
                View All Orders →
            </a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-500 border-b border-slate-200 dark:border-slate-800">
                    <tr>
                        <th class="py-2.5 px-3">Order Number</th>
                        <th class="py-2.5 px-3">Customer Name</th>
                        <th class="py-2.5 px-3">Date</th>
                        <th class="py-2.5 px-3">Creator User ID</th>
                        <th class="py-2.5 px-3 text-right">Total Amount (ETB)</th>
                        <th class="py-2.5 px-3 text-center">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/40">
                            <td class="py-2.5 px-3 font-mono font-bold text-primary-600 dark:text-primary-400">@order.OrderNumber</td>
                            <td class="py-2.5 px-3 font-medium text-slate-900 dark:text-white">@order.CustomerName</td>
                            <td class="py-2.5 px-3 text-slate-500">@order.OrderDate.ToString("yyyy-MM-dd")</td>
                            <td class="py-2.5 px-3 font-mono text-slate-500">@order.UserId</td>
                            <td class="py-2.5 px-3 font-mono text-right font-bold text-slate-900 dark:text-white">ETB @order.TotalAmount.ToString("N2")</td>
                            <td class="py-2.5 px-3 text-center">
                                <a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id" class="px-2.5 py-1 text-[11px] font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-primary-50 hover:text-primary-600 transition">
                                    Inspect
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>