@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="max-w-4xl mx-auto p-8 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm space-y-4">
    <h1 class="text-2xl font-bold text-slate-900 dark:text-white">Privacy Policy</h1>
    <p class="text-xs text-slate-500">Last updated: August 2026</p>

    <div class="text-xs text-slate-600 dark:text-slate-300 space-y-3 leading-relaxed">
        <p>
            This application uses ASP.NET Core Identity authentication cookies to safeguard your session. All order transactions and product catalogs are scoped according to strict role-based access rules.
        </p>
        <p>
            Standard user accounts can only view and manage orders tied directly to their individual User ID. System administrators retain catalog configuration rights and system-wide visibility.
        </p>
    </div>
</div>