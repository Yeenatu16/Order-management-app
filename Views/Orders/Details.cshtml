@model Order
@{
    ViewData["Title"] = "Order Details - " + Model.OrderNumber;
}

<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <h1 class="text-2xl font-bold font-mono text-slate-900 dark:text-white">@Model.OrderNumber</h1>
            <span class="px-2.5 py-0.5 text-xs font-mono font-medium rounded-full bg-emerald-50 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300 border border-emerald-200">
                Completed
            </span>
        </div>
        <a asp-action="Index" class="px-4 py-2 border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300 rounded-xl text-xs font-semibold hover:bg-slate-100 dark:hover:bg-slate-800 transition">
            ← Back to Orders
        </a>
    </div>

    <!-- Master Header Card -->
    <div class="p-6 bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
        <div>
            <span class="text-slate-400">Customer Name:</span>
            <p class="font-bold text-sm text-slate-900 dark:text-white mt-0.5">@Model.CustomerName</p>
        </div>
        <div>
            <span class="text-slate-400">Order Date:</span>
            <p class="font-mono text-sm text-slate-900 dark:text-white mt-0.5">@Model.OrderDate.ToString("yyyy-MM-dd HH:mm UTC")</p>
        </div>
        <div>
            <span class="text-slate-400">Creator User ID:</span>
            <p class="font-mono text-sm text-primary-600 dark:text-primary-400 mt-0.5">@Model.UserId</p>
        </div>
    </div>

    <!-- Detail Line Items Table -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-sm overflow-hidden space-y-3 p-6">
        <h2 class="text-sm font-bold text-slate-900 dark:text-white">Itemized Line Items</h2>
        <div class="overflow-x-auto border border-slate-200 dark:border-slate-800 rounded-xl">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 dark:bg-slate-800 text-slate-500 font-semibold border-b border-slate-200 dark:border-slate-800">
                    <tr>
                        <th class="py-3 px-4">Product</th>
                        <th class="py-3 px-4 text-center">Qty</th>
                        <th class="py-3 px-4 text-right">Unit Price (ETB)</th>
                        <th class="py-3 px-4 text-right">Subtotal (ETB)</th>
                        <th class="py-3 px-4 text-right">VAT (15%)</th>
                        <th class="py-3 px-4 text-right">Line Total (ETB)</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @foreach (var item in Model.LineItems)
                    {
                        <tr>
                            <td class="py-3 px-4 font-semibold text-slate-900 dark:text-white">
                                @(item.Product?.Name ?? $"Product ID: {item.ProductId}")
                                <span class="text-[10px] block font-mono text-slate-400">@(item.Product?.Code ?? "-")</span>
                            </td>
                            <td class="py-3 px-4 text-center font-mono font-medium">@item.Quantity</td>
                            <td class="py-3 px-4 text-right font-mono text-slate-600 dark:text-slate-400">ETB @item.UnitPrice.ToString("N2")</td>
                            <td class="py-3 px-4 text-right font-mono text-slate-600 dark:text-slate-400">ETB @item.Subtotal.ToString("N2")</td>
                            <td class="py-3 px-4 text-right font-mono text-slate-500">ETB @item.VAT.ToString("N2")</td>
                            <td class="py-3 px-4 text-right font-mono font-bold text-slate-900 dark:text-white">ETB @item.Total.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="flex justify-end pt-4">
            <div class="w-72 space-y-2 text-xs">
                <div class="flex justify-between text-slate-500">
                    <span>Total Subtotal:</span>
                    <span class="font-mono">ETB @Model.LineItems.Sum(li => li.Subtotal).ToString("N2")</span>
                </div>
                <div class="flex justify-between text-slate-500">
                    <span>Total VAT (15%):</span>
                    <span class="font-mono">ETB @Model.LineItems.Sum(li => li.VAT).ToString("N2")</span>
                </div>
                <div class="border-t border-slate-200 dark:border-slate-800 pt-2 flex justify-between font-bold text-sm">
                    <span class="text-slate-900 dark:text-white">Grand Total:</span>
                    <span class="font-mono text-primary-600 dark:text-primary-400">ETB @Model.TotalAmount.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>
</div>