@model IEnumerable<Order>
@{ ViewData["Title"] = "Orders"; }

<div class="max-w-7xl mx-auto space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
            <div class="flex items-center gap-3">
                <h1 class="text-2xl font-bold tracking-tight text-slate-900 dark:text-white">Order Transactions</h1>
                <span class="px-2.5 py-0.5 text-[11px] font-semibold rounded-full @(User.IsInRole("Admin") ? "bg-purple-50 text-purple-700 dark:bg-purple-950 dark:text-purple-300 border border-purple-200" : "bg-primary-50 text-primary-600 dark:bg-primary-950 dark:text-primary-300 border border-primary-200")">
                    @(User.IsInRole("Admin") ? "Admin: Viewing All System Orders" : "Standard User: Personal Orders")
                </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Review historical order records, line items breakdown, and tax totals.</p>
        </div>

        <a asp-action="Create" class="px-4 py-2 text-xs font-semibold rounded-xl bg-primary-600 hover:bg-primary-700 text-white shadow-md transition flex items-center justify-center gap-2 w-fit">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Create New Order
        </a>
    </div>

    <!-- Data Table -->
    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs">
                <thead class="bg-slate-50 dark:bg-slate-800 text-slate-500 font-semibold border-b border-slate-200 dark:border-slate-800">
                    <tr>
                        <th class="py-3.5 px-4">Order #</th>
                        <th class="py-3.5 px-4">Order Date</th>
                        <th class="py-3.5 px-4">Customer Name</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="py-3.5 px-4">Creator User ID</th>
                        }
                        <th class="py-3.5 px-4 text-center">Items</th>
                        <th class="py-3.5 px-4 text-right">Total Amount (ETB)</th>
                        <th class="py-3.5 px-4 text-center">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="@(User.IsInRole("Admin") ? 7 : 6)" class="py-8 text-center text-slate-400">
                                No orders found.
                            </td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr class="hover:bg-slate-50/50 dark:hover:bg-slate-800/40 transition">
                            <td class="py-3 px-4 font-mono font-bold text-primary-600 dark:text-primary-400">@item.OrderNumber</td>
                            <td class="py-3 px-4 text-slate-500">@item.OrderDate.ToString("yyyy-MM-dd")</td>
                            <td class="py-3 px-4 font-semibold text-slate-900 dark:text-white">@item.CustomerName</td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="py-3 px-4 font-mono text-slate-500">@item.UserId</td>
                            }
                            <td class="py-3 px-4 text-center font-bold">@item.LineItems.Count</td>
                            <td class="py-3 px-4 text-right font-mono font-bold text-slate-900 dark:text-white">ETB @item.TotalAmount.ToString("N2")</td>
                            <td class="py-3 px-4 text-center">
                                <a asp-action="Details" asp-route-id="@item.Id" class="px-2.5 py-1 text-[11px] font-semibold rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-primary-50 hover:text-primary-600 transition">
                                    Inspect
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>